# Gemini AI (for workout motivation / image analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (cloud persistence)
#
# These VITE_* values are inlined into the client at build time when they are
# present (e.g. `npm run dev`, which reads this file / .env.local).
#
# For the AI Studio DEPLOYED app, this local file is NOT used (it is gitignored).
# Instead the server exposes these same variables at runtime via
# /api/supabase-config, reading them from process.env. So, in AI Studio you must
# add BOTH of these to the app's Environment Variables / Secrets panel
# (alongside GEMINI_API_KEY) so the deployed app can reach the cloud:
#   - VITE_SUPABASE_URL
#   - VITE_SUPABASE_ANON_KEY
